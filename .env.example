# Firebase Project Configuration (Copy to .env.local and fill in development project values)
VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# Emulator & Demo Mode Settings
# Set VITE_USE_FIREBASE_EMULATOR=true when running local Firebase Emulators
VITE_USE_FIREBASE_EMULATOR=false
# Set VITE_DEMO_MODE=true when previewing UI locally before Firebase project credentials are configured
VITE_DEMO_MODE=true
